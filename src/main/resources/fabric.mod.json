{
  "schemaVersion": 1,
  "id": "btwr",
  "version": "${version}",
  "name": "BTWR:Core",
  "description": "",
  "authors": [
    "ivangeevo"
  ],
  "contact": {
    "repo": "https://github.com/ivangeevo/btwr-core"
  },
  "license": "MIT",
  "icon": "assets/btwr/btwr-circle.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "btwr.core.client.BTWRModClient"
    ],
    "main": [
      "btwr.core.BTWRMod"
    ],
    "fabric-datagen": [
      "btwr.core.BTWRDataGenerator"
    ],
    "modmenu": [
      "btwr.core.config.BTWRModMenu"
    ]
  },
  "mixins": [
    "btwr-core.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}"
  },

  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/class_1548": ["btwr/core/entity/interfaces/CreeperEntityAdded"],
      "net/minecraft/class_1657": ["btwr/core/entity/interfaces/PlayerEntityAdded"],
      "net/minecraft/class_2248": ["btwr/core/block/interfaces/BlockAdded"],
      "net/minecraft/class_1867": ["btwr/core/recipe/interfaces/ShapelessRecipeAdded"],
      "net/minecraft/class_2450": ["btwr/core/recipe/interfaces/ShapelessRecipeJsonBuilderAdded"]


    }
  },

  "accessWidener" : "btwr.accesswidener"
}
