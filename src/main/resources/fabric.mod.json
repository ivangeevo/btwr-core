{
  "schemaVersion": 1,
  "id": "btwr",
  "version": "${version}",
  "name": "BTWR: Core",
  "description": "The core mod for the Better Than Wolves:Remastered! modpack.",
  "authors": [
    "ivangeevo"
  ],
  "contact": {
    "repo": "https://github.com/ivangeevo/btwr-core"
  },
  "license": "CC-BY 4.0",
  "icon": "assets/btwr/btwr-circle.png",
  "environment": "*",
  "entrypoints": {
    "client": ["org.btwr.core.BTWRModClient"],
    "main": ["org.btwr.core.BTWRMod"],
    "fabric-datagen": ["org.btwr.core.BTWRDataGenerator"],
    "modmenu": ["org.btwr.core.config.BTWRModMenu"]
  },
  "mixins": [
    "btwr-core.mixins.json",
    {
      "config": "btwr-core.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}",
    "btwr_sl": ">=${btwr_sl_version}"
  },
  "accessWidener" : "btwr-core.accesswidener"
}