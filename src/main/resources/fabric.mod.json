{
  "schemaVersion": 1,
  "id": "btwr",
  "version": "${version}",
  "name": "BTWR: Core",
  "description": "The core mod for the Better Than Wolves:Remastered! modpack.",
  "authors": [
    "ivangeevo"
  ],
  "contact": {
    "repo": "https://github.com/ivangeevo/btwr-core"
  },
  "license": "CC-BY 4.0",
  "icon": "assets/btwr/btwr-circle.png",
  "environment": "*",
  "entrypoints": {
    "client": ["btwr.core.client.BTWRModClient"],
    "main": ["btwr.core.BTWRMod"],
    "fabric-datagen": ["btwr.core.BTWRDataGenerator"],
    "modmenu": ["btwr.core.config.BTWRModMenu"]
  },
  "mixins": [
    "btwr-core.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}",
    "btwr_sl": ">=${btwr_sl_version}"
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/class_1548": ["btwr/core/entity/interfaces/CreeperEntityAdded"]
    }
  },

  "accessWidener" : "btwr.accesswidener"
}
